---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import Folder from "../components/Folder.astro";
import Sticker from "../components/Sticker.astro";
import Window from "../components/Window.astro";
import SectionHead from "../components/SectionHead.astro";
import Logo from "../components/Logo.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects, dataProjects, jobs, hackathons, skills, beamProjects, logos, logoOrder, contact } from "../data/content";
import { to } from "../lib/url";

const p = Astro.url.pathname;
const listJoin = (xs: string[]) => (xs.length < 2 ? xs.join("") : `${xs.slice(0, -1).join(", ")} and ${xs[xs.length - 1]}`);

// Beam geometry (no-JS fallback): skills and projects both sit on 58px rows.
const beams = skills.flatMap((s, i) =>
  s.links.map((j) => {
    const ys = 29 + 58 * i;
    const yp = 29 + 58 * j;
    return { skill: i, proj: j, d: `M33 ${ys} C 50 ${ys}, 50 ${yp}, 67 ${yp}` };
  }),
);
---

<Layout>
  <Nav slot="nav" current="home" />

  <header class="hero" id="top">
    <span class="glow glow--pink" aria-hidden="true" data-parallax="0.25"></span>
    <span class="glow glow--jas" aria-hidden="true" data-parallax="-0.2"></span>
    <svg class="ribbons" viewBox="0 0 1440 760" preserveAspectRatio="none" aria-hidden="true">
      <path d="M-40 250 C 260 110, 520 430, 820 300 S 1260 110, 1500 250"></path>
      <path d="M-40 560 C 300 400, 620 660, 920 520 S 1300 380, 1500 540"></path>
    </svg>
    <div class="wrap hero__grid">
      <div class="hero__copy" data-hero-copy>
        <span class="status" data-intro><span class="status__dot" aria-hidden="true"></span><span class="status__label">Now:</span> BD analyst intern at Sidekick <span class="chip chip--jasmine">YC S26</span></span>
        <h1 class="h-xl" data-hero-title>
          <span class="hero__name">Lynn Le,</span>
          <span class="rot" data-rot aria-label="data analyst, dashboard builder, sidequester"><span>data analyst.</span><span aria-hidden="true">dashboard builder.</span><span aria-hidden="true">sidequester.</span></span>
        </h1>
        <p class="lead" data-intro>Final-year Business Analytics student at Deakin who cleans messy data, builds the dashboards on top, and turns what they show into decisions a team can act on.</p>
        <div class="hero__ctas" data-intro>
          <a class="btn btn--primary magnetic" href={to(p, "projects.html")}><Icon name="chart-bar" />See the projects</a>
          <a class="btn btn--secondary magnetic" href={to(p, "life-story.html")}>Read my life story</a>
        </div>
      </div>

      <div class="hero__art" data-hero-art>
        <span class="twk" style="left: 30%; top: 4%; font-size: 18px" aria-hidden="true" data-twinkle>✦</span>
        <span class="twk" style="right: 18%; top: 6%; font-size: 13px; color: var(--caramel)" aria-hidden="true" data-twinkle>✦</span>
        <span class="twk" style="right: 6%; bottom: 22%; font-size: 22px; color: #FFFFFF" aria-hidden="true" data-twinkle>✦</span>
        <span class="twk" style="left: 38%; bottom: 4%; font-size: 11px; color: var(--jasmine-deep)" aria-hidden="true" data-twinkle>✦</span>

        <div class="bigf" data-bigf>
          <div class="bigf__back"></div>
          <figure class="bigf__photo" data-photo tabindex="0" aria-label="Photo of Lynn. Press and hold to lift it out of the folder.">
            <div class="photo photo--img"><img src={to(p, "img/lynn.webp")} srcset={`${to(p, "img/lynn-400.webp")} 400w, ${to(p, "img/lynn.webp")} 640w`} sizes="210px" width="640" height="800" alt="Lynn Le smiling, in a black top" draggable="false" fetchpriority="high" decoding="async" /></div>
            <figcaption>Lynn, mid-sidequest</figcaption>
          </figure>
          <span class="tag tag--1">SQL</span>
          <span class="tag tag--2">Power BI</span>
          <div class="bigf__front"></div>
          <span class="tag tag--3">Insights</span>
        </div>

        <Folder fill="rose" icon="chart-bar" label="Projects" href={to(p, "projects.html")} class="orbit orbit--a" data-drag data-parallax="0.5" />
        <Folder fill="jasmine" icon="file-text" label="life-story.txt" href={to(p, "life-story.html")} class="orbit orbit--b" data-drag data-parallax="0.3" />
        <Folder fill="mist" icon="file-text" label="resume.pdf" href={to(p, contact.resume)} class="orbit orbit--c" data-drag data-parallax="0.7" data-resume />
      </div>
    </div>
  </header>

  <section class="wrap stats-sec" aria-label="Numbers from the CV">
    <div class="stats">
      <div class="stat stat--lead" data-rise>
        <Icon name="database" />
        <span class="metric" data-count="10000" data-suffix="+">10,000+</span>
        <p class="stat__cap">Client records cleaned and standardised at SW Education, then turned into Power BI dashboards</p>
      </div>
      <div class="stat card" data-rise>
        <Icon name="trend-up" />
        <span class="metric" data-count="3" data-suffix="x">3x</span>
        <p class="stat__cap">Qualified pipeline at Sidekick, from 30+ segmented prospect profiles</p>
      </div>
      <div class="stat card" data-rise>
        <Icon name="brain" />
        <span class="metric" data-count="24">24</span>
        <p class="stat__cap">Predictive models built and compared for RetailPro</p>
      </div>
      <div class="stat card" data-rise>
        <Icon name="buildings" />
        <span class="metric">$11.36M</span>
        <p class="stat__cap">In non-billable cost traced to its source for BGIS</p>
      </div>
    </div>
  </section>

  <section class="wrap logos-sec" aria-labelledby="logos-h">
    <div class="logos card" data-rise>
      <h2 id="logos-h" class="logos__label"><span aria-hidden="true">✦</span> where I've clocked in</h2>
      <div class="marquee">
        {[0, 1].map((copy) => (
          <ul class="marquee__track" aria-hidden={copy ? "true" : undefined}>
            {logoOrder.map((id) => (
              <li><a class="logos__item" href={to(p, logos[id].href)} aria-label={`${logos[id].name}, open the case study`} tabindex={copy ? -1 : undefined}><Logo id={id} variant="full" /></a></li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>


  <section id="projects" class="wrap sec" aria-labelledby="projects-h">
    <SectionHead id="projects-h" hint="Each one has a write-up and the code" hintIcon="chart-bar">Projects with real data <span class="em">inside.</span></SectionHead>
    <div class="pj-grid">
      {dataProjects.slice(0, 4).map((d, i) => <ProjectCard d={d} lead={i === 1} data-rise />)}
      <div class="pj-more card" data-rise>
        <p class="pj-more__h">{dataProjects.length - 4} more in the folder.</p>
        <p class="p">{listJoin(dataProjects.slice(4).map((d) => d.name))}, plus a list view of all {dataProjects.length}.</p>
        <a class="btn btn--secondary magnetic" href={to(p, "projects.html")}><Icon name="folder-open" />Open the projects folder</a>
      </div>
    </div>
  </section>

  <section id="work" class="wrap sec" aria-labelledby="work-h">
    <SectionHead id="work-h" hint="Psst, drag these. click one to open it." hintIcon="hand-grabbing">Where the work happened, in <span class="em">folders.</span></SectionHead>
    <div class="board desk" data-desk>
      {projects.map((w) => (
        <Folder fill={w.fill} icon={w.icon} logo={w.logo} label={w.label} meta={w.meta} href={to(p, `works/${w.slug}.html`)} style={`left: ${w.pos.left}; top: ${w.pos.top}`} data-drag />
      ))}
      <Sticker as="aside" fill="jasmine" status="Note to self" title="Every number in here is on my CV." note="No rounding up. If it isn't real, it isn't in a folder." class="desk__note" />
    </div>
  </section>

  <section id="experience" class="wrap sec" aria-labelledby="exp-h">
    <SectionHead id="exp-h" hint="Current roles first" hintIcon="calendar-blank">Where I've <span class="em">clocked in.</span></SectionHead>
    <div class="jobs">
      {jobs.map((j) => (
        <a class="job card" href={to(p, `works/${j.slug}.html`)} data-row>
          <div class="job__meta">
            <Logo id={j.logo} variant="tile" />
            <div>
              <p class="job__org">{j.org}{j.chip && <span class="chip chip--jasmine">{j.chip}</span>}</p>
              <p class="job__dates">{j.dates}</p>
            </div>
          </div>
          <div>
            <h3 class="job__role">{j.role}</h3>
            <p class="p">{j.note}</p>
          </div>
          <span class="job__go" aria-hidden="true"><Icon name="arrow-up-right" /></span>
        </a>
      ))}
    </div>
  </section>

  <section id="hackathons" class="wrap sec" aria-labelledby="hack-h">
    <SectionHead id="hack-h" hint="Four events in five months, 2026" hintIcon="trophy">Hackathons and <span class="em">competitions.</span></SectionHead>
    <div class="hk-grid">
      {hackathons.map((h) => (
        <article class={`hk card${h.highlight ? " hk--top" : ""}`} data-rise>
          <span class="hk__icon" aria-hidden="true"><Icon name={h.icon} weight="bold" /></span>
          <p class="hk__date">{h.date}</p>
          <h3 class="hk__name">{h.name}</h3>
          <p class="hk__by">{h.by}</p>
          <p class="hk__result">{h.result}</p>
          {h.href && <a class="tick-link hk__link" href={h.href} target="_blank" rel="noopener noreferrer">{h.link}<Icon name="arrow-up-right" /></a>}
        </article>
      ))}
    </div>
    <a class="btn btn--secondary magnetic hk__more" href={to(p, "works/hackathons.html")} data-rise><Icon name="folder-open" />Open the hackathon folder</a>
  </section>

  <section id="skills" class="wrap sec" aria-labelledby="skills-h">
    <SectionHead id="skills-h" hint="Pick a skill to trace it" hintIcon="magnifying-glass">What I'm good at, and <span class="em">where.</span></SectionHead>
    <div class="card beams" data-beams data-rise>
      <div class="beam">
        <svg class="beam__svg" data-beam-svg viewBox="0 0 100 348" preserveAspectRatio="none" aria-hidden="true">
          {beams.map((b) => <path class={`beam__line${b.skill === 0 ? " on" : ""}`} data-skill={b.skill} data-proj-link={b.proj} d={b.d}></path>)}
        </svg>
        <div class="beam__col beam__col--l">
          {skills.map((s, i) => (
            <button type="button" class={`skill${i === 0 ? " on" : ""}`} data-skill-btn={i} data-links={s.links.join(",")} data-note={s.note}>{s.label}</button>
          ))}
        </div>
        <div class="beam__to" aria-hidden="true"><Icon name="arrow-down" weight="bold" /><span>Shows up at</span></div>
        <div class="beam__col beam__col--r">
          {beamProjects.map((bp, j) => (
            <span class={`proj f-${bp.fill}${skills[0].links.includes(j) ? " on" : ""}`} data-proj={j}><Logo id={bp.logo} variant="tile" class="co-logo--sm" />{bp.label}</span>
          ))}
        </div>
      </div>
      <p class="beam-note" data-beam-note aria-live="polite">{skills[0].note}</p>
    </div>
  </section>

  <section id="story" class="wrap sec" aria-labelledby="story-h">
    <SectionHead id="story-h" hint="It's a .txt file, but a cute one" hintIcon="file-text">The long version has <span class="em">sidequests.</span></SectionHead>
    <Window path="~/lynn/life-story.txt" meta="8 chapters so far" data-rise bodyClass="teaser">
      <div style="display: flex; flex-direction: column; gap: 24px; align-items: flex-start">
        <ul class="teaser__lines">
          <li><b>2024</b>New city, new degree, a merit scholarship</li>
          <li><b>2024</b>Built my first CRM at Codrops</li>
          <li><b>2024</b>Crochet small biz era</li>
          <li><b>2025</b>Cleaned ten thousand records</li>
          <li><b>2026</b>Learned to query, seven projects deep</li>
          <li><b>2026</b>Joined a YC startup</li>
        </ul>
        <a class="btn btn--secondary magnetic" href={to(p, "life-story.html")}>Read my life story</a>
      </div>
      <div class="teaser__stack" aria-hidden="true">
        <Sticker as="div" fill="berry" status="Ongoing" title="Mentor first-years" style="left: 4%; top: 6%; rotate: -5deg" data-parallax="0.35" />
        <Sticker as="div" fill="jasmine" status="Complete" title="Run a shop on real data" style="right: 0; top: 34%; rotate: 4deg" data-parallax="0.15" />
        <Sticker as="div" fill="open" status="Your next quest" title="Add a quest" style="left: 10%; bottom: 0; rotate: -2deg" data-parallax="0.55" />
      </div>
    </Window>
  </section>

  <Footer slot="footer" />
</Layout>

<script>
  import "../scripts/home";
</script>
