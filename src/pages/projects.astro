---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import FolderIcon from "../components/FolderIcon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Window from "../components/Window.astro";
import { dataProjects, contact } from "../data/content";
import { to } from "../lib/url";

const p = Astro.url.pathname;
const headline = (d: (typeof dataProjects)[number]) => {
  const m = d.metrics[0];
  return m.value === null ? m.text : `${m.prefix ?? ""}${m.value.toLocaleString("en-US")}${m.suffix ?? ""}`;
};
---

<Layout title="Lynn Le, projects" description="Seven data projects by Lynn Le: BGIS workforce analytics, Altano Bank BI, Wellora marketing analytics, NextWave RFM, RetailPro predictive models, Apex data cleaning and Adidas social listening.">
  <Nav slot="nav" current="projects" />

  <div class="wrap ls-head">
    <Window path="~/lynn/projects" meta={`${dataProjects.length} projects`} closeHref={to(p, "index.html")} closeLabel="Close and go home" bodyClass="ls-intro">
      <div style="display: flex; flex-direction: column; gap: 20px">
        <h1 class="h-xl" data-split-lines>The projects <span class="em">folder.</span></h1>
        <p class="lead" data-intro>Seven projects in SQL, Power BI, Python and Excel. Each one opens with the brief, how I worked through it, what the data said, and what I'd do next.</p>
      </div>
      <a class="btn btn--secondary magnetic" href={contact.github} target="_blank" rel="noopener noreferrer" data-intro><Icon name="github-logo" />all the code on GitHub</a>
    </Window>
  </div>

  <section class="wrap sec" aria-labelledby="cards-h">
    <h2 id="cards-h" class="sr">Project cards</h2>
    <div class="pj-grid">
      {dataProjects.map((d, i) => <ProjectCard d={d} lead={i === 1} data-rise />)}
    </div>
  </section>

  <section class="wrap sec" aria-labelledby="list-h">
    <div class="sec-head">
      <h2 id="list-h" class="h-lg" data-rise>Same projects, <span class="em">list view.</span></h2>
      <span class="hint" data-rise><Icon name="list-bullets" />for when you'd rather scan</span>
    </div>
    <Window path="~/lynn/projects" meta={`${dataProjects.length} projects`} class="finder-win" bodyClass="finder-body" data-rise>
      <div class="finder__head" aria-hidden="true"><span>name</span><span>headline</span></div>
      <div class="finder" role="list">
        {dataProjects.map((d) => (
          <a class="finder__row" href={to(p, `projects/${d.slug}.html`)} role="listitem" data-row>
            <FolderIcon icon={d.icon} fill={d.fill} />
            <span class="finder__main">
              <span class="finder__title">{d.titleA} {d.titleEm}</span>
              <span class="finder__sub">{d.name}<i aria-hidden="true">·</i>{d.tools.slice(0, 3).join(", ")}</span>
            </span>
            <span class="finder__num"><b>{headline(d)}</b><small>{d.metrics[0].caption}</small></span>
            <span class="finder__go" aria-hidden="true"><Icon name="caret-right" weight="bold" /></span>
          </a>
        ))}
      </div>
      <div class="finder__status"><span>{dataProjects.length} items</span><span>numbers from my own write-ups</span></div>
    </Window>
  </section>

  <Footer slot="footer" />
</Layout>

<script>
  import "../scripts/home";
</script>
