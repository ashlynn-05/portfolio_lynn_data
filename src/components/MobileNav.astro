---
import { to } from "../lib/url";
import { contact } from "../data/content";

const p = Astro.url.pathname;
const ITEMS = [
  { label: "Home", sub: "The desktop", href: to(p, "index.html") },
  { label: "Projects", sub: "Seven data projects, with code", href: to(p, "projects.html") },
  { label: "Experience", sub: "Four roles, real numbers", href: to(p, "works.html") },
  { label: "Life story", sub: "The long version, with sidequests", href: to(p, "life-story.html") },
];
---

<div class="mnav" id="mnav" role="dialog" aria-modal="true" aria-label="Menu">
  <ul>
    {ITEMS.map((it, i) => (
      <li>
        <a class="mnav__item" href={it.href} style={`--i:${i}`}>
          <span class="mnav__spark" aria-hidden="true">✦</span>
          <span>
            <span class="mnav__mask"><span class="mnav__t">{it.label}</span></span>
            <span class="mnav__s">{it.sub}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  <div class="mnav__foot">
    <a class="btn btn--onberry" href="#hi">Say hi</a>
    <p class="copyline"><span>{contact.email}</span></p>
    <p class="mnav__social"><a href={contact.linkedin} target="_blank" rel="noopener noreferrer">Linkedin</a><a href={contact.github} target="_blank" rel="noopener noreferrer">Github</a></p>
  </div>
</div>
