---
// A data project as a card: a dashboard or chart cover, folder glyph, name, one-line summary,
// the headline number, the tools, then links to the write-up and the code. The title link stretches over
// the whole card, and the GitHub link sits above it so both stay clickable.
import Icon from "./Icon.astro";
import FolderIcon from "./FolderIcon.astro";
import Metric from "./Metric.astro";
import type { DataProject } from "../data/content";
import { to } from "../lib/url";
import { figSrcset } from "../lib/figure";

interface Props { d: DataProject; lead?: boolean; [key: string]: unknown }
const { d, lead = false, ...rest } = Astro.props;
const p = Astro.url.pathname;
const m = d.metrics[0];
// The wide lead card stacks two dashboards in its cover column; the rest show one.
const covers = (d.figures ?? []).slice(0, lead ? 2 : 1);
---
<article class={`pj card${lead ? " pj--lead" : ""}`} {...rest}>
  {covers.length > 0 && (
    <div class="pj__cover">{covers.map((c) => <img src={to(p, c.src)} srcset={figSrcset(p, c)} sizes="(max-width: 760px) calc(100vw - 60px), (max-width: 1060px) 46vw, 360px" width={c.w} height={c.h} alt={c.alt} style={c.pos && `object-position: ${c.pos}`} loading="lazy" decoding="async" />)}</div>
  )}
  <div class="pj__body">
    <div class="pj__top">
      <FolderIcon icon={d.icon} fill={d.fill} class="pj__fold" />
      <span class="pj__kind">{d.kind}<i aria-hidden="true">·</i>{d.year}</span>
    </div>
    <h3 class="pj__name"><a href={to(p, `projects/${d.slug}.html`)} class="pj__link">{d.name}</a></h3>
    <p class="pj__sum">{d.summary}</p>
    <div class="pj__num"><Metric value={m.value} prefix={m.prefix} suffix={m.suffix} text={m.text} class="pj__metric" /><span>{m.caption}</span></div>
    <ul class="pj__tools">{d.tools.map((t) => <li class="chip chip--outline">{t}</li>)}</ul>
    <div class="pj__foot">
      <span class="pj__open">Open the case<Icon name="arrow-right" /></span>
      <span class="pj__links"><a class="pj__gh" href={d.github} target="_blank" rel="noopener noreferrer" aria-label={`${d.name} on GitHub`}><Icon name="github-logo" />Code</a>
      {(d.sources ?? []).map((s) => <a class="pj__gh" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`${d.name}: ${s.label}`}><Icon name={s.icon} />{s.short}</a>)}</span>
    </div>
  </div>
</article>
